{
  "name": "kbo-live-monorepo",
  "private": true,
  "packageManager": "npm@11.21.0",
  "engines": {
    "npm": ">=11",
    "node": ">=20.17"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w kbo-live",
    "test": "npm test --workspaces --if-present",
    "test:cli": "npm test -w kbo-live",
    "test:web": "npm test -w web",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:start": "npm run start -w web"
  }
}
